// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "RAPIDS Docs",
	"image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": {
			"label": "RAPIDS Docs",
			"onAutoForward": "openPreview"
		}
	},
	"postCreateCommand": "pipx install uv && uv sync --locked"
}
